#!/bin/bash
set -euo pipefail

usage() {
    echo "Usage: test-db-connection [--ssl] <type> <host> <port> [database] [username]"
    echo "Types: postgres, mysql, mongo, redis"
    echo ""
    echo "Options:"
    echo "  --ssl    Enable TLS/SSL for the connection"
    echo ""
    echo "Environment variables:"
    echo "  PGPASSWORD  - PostgreSQL password"
    echo "  MYSQL_PWD   - MySQL password"
    echo "  REDIS_AUTH   - Redis authentication password"
    echo ""
    echo "Examples:"
    echo "  test-db-connection postgres localhost 5432 mydb myuser"
    echo "  test-db-connection --ssl redis localhost 6379"
    echo "  PGPASSWORD=secret test-db-connection postgres db-host 5432 mydb admin"
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    usage
    exit 0
fi

SSL=false
while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --ssl) SSL=true; shift ;;
        *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
done

if [ $# -lt 3 ]; then
    usage
    exit 1
fi

TYPE=$1
HOST=$2
PORT=$3
DATABASE=${4:-}
USERNAME=${5:-}

echo "Testing connection to $TYPE at $HOST:$PORT..."
[ "$SSL" = true ] && echo "TLS/SSL: enabled"

case $TYPE in
    postgres)
        if [ -z "$USERNAME" ]; then
            echo "Username required for PostgreSQL"
            exit 1
        fi
        SSL_OPT=""
        [ "$SSL" = true ] && SSL_OPT="sslmode=require"
        if [ -n "$SSL_OPT" ]; then
            psql "host=$HOST port=$PORT user=$USERNAME dbname=${DATABASE:-postgres} $SSL_OPT" -c "SELECT 1;"
        else
            psql -h "$HOST" -p "$PORT" -U "$USERNAME" -d "${DATABASE:-postgres}" -c "SELECT 1;"
        fi
        ;;
    mysql)
        if [ -z "$USERNAME" ]; then
            echo "Username required for MySQL"
            exit 1
        fi
        SSL_OPT=""
        [ "$SSL" = true ] && SSL_OPT="--ssl-mode=REQUIRED"
        if [ -n "${MYSQL_PWD:-}" ]; then
            mysql -h "$HOST" -P "$PORT" -u "$USERNAME" $SSL_OPT -e "SELECT 1;" "${DATABASE:-mysql}"
        else
            echo "Note: Set MYSQL_PWD env var to avoid password prompt"
            mysql -h "$HOST" -P "$PORT" -u "$USERNAME" -p $SSL_OPT -e "SELECT 1;" "${DATABASE:-mysql}"
        fi
        ;;
    mongo)
        SSL_OPT=""
        [ "$SSL" = true ] && SSL_OPT="--tls"
        if command -v mongosh >/dev/null 2>&1; then
            mongosh --host "$HOST:$PORT" $SSL_OPT --eval "db.runCommand('ping')"
        elif command -v mongo >/dev/null 2>&1; then
            mongo --host "$HOST:$PORT" $SSL_OPT --eval "db.runCommand('ping')"
        else
            echo "MongoDB client not available. Testing basic connectivity..."
            nc -zv "$HOST" "$PORT"
        fi
        ;;
    redis)
        REDIS_OPTS="-h $HOST -p $PORT"
        [ "$SSL" = true ] && REDIS_OPTS="$REDIS_OPTS --tls"
        [ -n "${REDIS_AUTH:-}" ] && REDIS_OPTS="$REDIS_OPTS -a $REDIS_AUTH"
        redis-cli $REDIS_OPTS ping
        ;;
    *)
        echo "Unsupported database type: $TYPE"
        usage
        exit 1
        ;;
esac
